{
  "name": "riftri-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:production": "node ../package/scripts/verify-website.mjs",
    "deploy:production": "pnpm type-check && pnpm build && pnpm test:browser && vercel deploy --prebuilt --prod --yes --scope assistant-ui && pnpm verify:production",
    "test:browser": "playwright test",
    "preview:static": "node scripts/serve-static.mjs",
    "generate:sharing-card": "node scripts/generate-sharing-card.mjs",
    "stage": "node ../package/scripts/stage-website-installer.mjs && node ../package/scripts/stage-website-docs.mjs && node scripts/stage-doc-icons.mjs",
    "dev": "pnpm run stage && farm dev",
    "build": "pnpm run stage && farm build && node ../package/scripts/finalize-static-website.mjs",
    "type-check": "tsc --noEmit",
    "generate": "farm generate"
  },
  "devDependencies": {
    "@farm.js/cli": "0.1.66",
    "@farm.js/core": "0.1.66",
    "@farming-labs/docs": "0.2.143",
    "@farming-labs/farmjs": "0.2.143",
    "@farming-labs/theme": "0.2.143",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8"
}
