{
  "name": "riftri-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:production": "node ../package/scripts/verify-website.mjs",
    "deploy:production": "pnpm type-check && pnpm build && pnpm test:browser && vercel deploy --prebuilt --prod --yes --scope assistant-ui && pnpm verify:production",
    "test:browser": "playwright test",
    "preview:static": "node scripts/serve-static.mjs",
    "generate:sharing-card": "node scripts/generate-sharing-card.mjs",
    "stage": "node ../package/scripts/stage-website-installer.mjs && node ../package/scripts/stage-website-docs.mjs && node scripts/stage-doc-icons.mjs",
    "dev": "pnpm stage && farm dev",
    "build": "pnpm stage && farm build && node ../package/scripts/finalize-static-website.mjs",
    "type-check": "tsc --noEmit",
    "generate": "farm generate"
  },
  "devDependencies": {
    "@farming-labs/docs": "0.2.115",
    "@farming-labs/farmjs": "0.2.115",
    "@farming-labs/theme": "0.2.115",
    "@farm.js/cli": "0.1.0-beta.95",
    "@farm.js/core": "0.1.0-beta.95",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "lucide-react": "1.47.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "overrides": {
      "@ai-sdk/provider-utils": "4.0.40",
      "image-size": "2.0.4",
      "sharp": "0.35.4",
      "srvx": "1.0.4",
      "uuid": "11.1.1",
      "yaml": "2.9.1"
    }
  }
}
