{
  "name": "riftri-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:production": "node ../package/scripts/verify-website.mjs",
    "deploy:production": "pnpm type-check && pnpm build && pnpm test:browser && vercel deploy --prebuilt --prod --yes --scope assistant-ui && pnpm verify:production",
    "test:browser": "playwright test",
    "preview:static": "node scripts/serve-static.mjs",
    "generate:sharing-card": "node scripts/generate-sharing-card.mjs",
    "stage": "node ../package/scripts/stage-website-installer.mjs && node ../package/scripts/stage-website-docs.mjs && node scripts/stage-doc-icons.mjs",
    "dev": "pnpm stage && farm dev",
    "build": "pnpm stage && farm build && node ../package/scripts/finalize-static-website.mjs",
    "type-check": "tsc --noEmit",
    "generate": "farm generate"
  },
  "devDependencies": {
    "@farm.js/cli": "0.1.61",
    "@farm.js/core": "0.1.61",
    "@farming-labs/docs": "0.2.143",
    "@farming-labs/farmjs": "0.2.143",
    "@farming-labs/theme": "0.2.143",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "overrides": {
      "nanoid@>=5.0.0 <5.1.16": "5.1.16",
      "srvx": "1.0.4",
      "toml@<5.0.1": "5.0.1",
      "uuid": "11.1.1",
      "@vercel/og@<1.0.3": "1.0.3",
      "yaml": "2.9.1"
    }
  }
}
