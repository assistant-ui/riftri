+// Coordination for optional hints only, never an integrity or lifecycle lock.
+// The existing source directory inode needs no new durable bookkeeping file.
+pub(super) struct HintAdmission {
+    _directory: fs::File,
+}
+
+impl Drop for HintAdmission {
+    fn drop(&mut self) {
+        // A concurrent fork can briefly inherit this open-file description
+        // before exec closes CLOEXEC handles. Closing only our descriptor
+        // would leave admission held by that duplicate. Explicitly release
+        // this advisory hint lock before the File field closes.
+        // SAFETY: the owned descriptor remains live throughout unlock.
+        let _ = unsafe { libc::flock(self._directory.as_raw_fd(), libc::LOCK_UN) };
+    }
+}
+
+impl HintAdmission {
+    pub(super) fn try_acquire(source: &Path) -> Option<Self> {
+        Self::acquire(source).ok()
+    }
+
+    fn acquire(source: &Path) -> io::Result<Self> {
+        let directory = fs::OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)
+            .open(source)?;
+        // SAFETY: directory owns a live, no-follow directory descriptor.
+        // LOCK_NB never waits for another holder. Drop explicitly releases
+        // admission; process death closes owned handles. A failure of any
+        // kind skips optional hints without failing native creation.
+        if unsafe { libc::flock(directory.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) } != 0 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(Self {
+            _directory: directory,
+        })
+    }
+}
