 // This is a kernel-cache hint, not a validation shortcut. Limit both the amount
 // requested for a large file and the total requested by one clone operation.
 const MAX_FILE_BYTES: u64 = 64 * 1024;
 const MAX_TREE_BYTES: u64 = 64 * 1024 * 1024;
 
+/// Optional hints captured while cloning. Paths are relative to the completed
+/// view, so activation can rename that view before its initial Git check.
+#[derive(Default)]
+pub struct ReadAheadPlan {
+    files: Vec<(PathBuf, u64)>,
+}
+
+impl ReadAheadPlan {
+    pub(super) fn new(files: Vec<(PathBuf, u64)>) -> Self {
+        Self { files }
+    }
+
+    /// Run an operation on the caller while issuing bounded optional hints.
+    /// Stop admitting hints when it returns or unwinds, and join every worker
+    /// before returning. An already admitted kernel call cannot be cancelled.
+    pub fn during<R>(self, destination: &Path, operation: impl FnOnce() -> R) -> R {
+        let hints = ReadAhead::new();
+        during(
+            &self.files,
+            crate::parallel::file_clone_parallelism(),
+            |(relative, length), _| hints.advise(&destination.join(relative), *length),
+            operation,
+        )
+    }
+}
+
+struct StopOnDrop<'a>(&'a AtomicBool);
+
+impl Drop for StopOnDrop<'_> {
+    fn drop(&mut self) {
+        self.0.store(true, Ordering::Release);
+    }
+}
+
+fn during<T: Sync, R>(
+    items: &[T],
+    worker_limit: usize,
+    advise: impl Fn(&T, &AtomicBool) + Sync,
+    operation: impl FnOnce() -> R,
+) -> R {
+    if items.is_empty() {
+        return operation();
+    }
+    let stopped = AtomicBool::new(false);
+    let next = AtomicUsize::new(0);
+    std::thread::scope(|scope| {
+        // This guard drops inside the scope, including during unwinding,
+        // before scope joins workers. No worker outlives the Git operation's
+        // result and reaches a later journal, cleanup or hook phase.
+        let _stop = StopOnDrop(&stopped);
+        for _ in 0..worker_limit.max(1).min(items.len()) {
+            // Thread resource exhaustion may omit optional hints, never fail
+            // creation or create an unscoped background worker.
+            let _ = std::thread::Builder::new().spawn_scoped(scope, || {
+                while !stopped.load(Ordering::Acquire) {
+                    let Some(item) = items.get(next.fetch_add(1, Ordering::Relaxed)) else {
+                        break;
+                    };
+                    advise(item, &stopped);
+                }
+            });
+        }
+        operation()
+    })
+}
