+/// Optional hints captured without issuing reads during native cloning.
+/// Relative paths follow the completed view when the caller activates it.
+#[derive(Default)]
+pub struct ReadAheadPlan {
+    files: Vec<(PathBuf, u64)>,
+}
+
+impl ReadAheadPlan {
+    pub(super) fn new(files: Vec<(PathBuf, u64)>) -> Self {
+        Self { files }
+    }
+
+    /// Issue bounded best-effort hints and join every worker before returning.
+    /// This does not wait for the kernel's asynchronous reads to finish and
+    /// never substitutes for the caller's full Git content check.
+    pub fn issue(self, destination: &Path) {
+        let hints = ReadAhead::new();
+        self.issue_with(destination, &|path, length| hints.advise(path, length));
+    }
+
+    fn issue_with(self, destination: &Path, advise: &(impl Fn(&Path, u64) + Sync)) {
+        let _ = crate::parallel::try_for_each_bounded(
+            self.files,
+            crate::parallel::file_clone_parallelism(),
+            |(relative, length)| {
+                advise(&destination.join(relative), length);
+                Ok::<(), std::convert::Infallible>(())
+            },
+        );
+    }
+}
