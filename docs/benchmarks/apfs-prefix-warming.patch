+
+fn warm_prefix(reader: &mut impl io::Read, count: usize) -> io::Result<()> {
+    let mut buffer = [0; MAX_FILE_BYTES as usize];
+    let mut remaining = count.min(buffer.len());
+    while remaining > 0 {
+        match reader.read(&mut buffer[..remaining]) {
+            Ok(0) => break,
+            Ok(read) => remaining -= read,
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+            Err(error) => return Err(error),
+        }
     }
     Ok(())
 }
