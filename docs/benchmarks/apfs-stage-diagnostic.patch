index 6e6b7ff..4047979 100644
--- a/crates/riftri-core/src/worktree.rs
+++ b/crates/riftri-core/src/worktree.rs
@@ -4293,8 +4293,18 @@ fn advance(
     phase: AddWorktreePhase,
     fail_after: Option<AddWorktreePhase>,
 ) -> Result<(), WorktreeError> {
+    eprintln!(
+        "riftri: journal-stage: start {phase:?} pid={}",
+        std::process::id()
+    );
+    let stage_started = std::time::Instant::now();
     journal.transition(phase)?;
     store.persist(journal)?;
+    eprintln!(
+        "riftri: journal-stage: finish {phase:?} pid={} microseconds={}",
+        std::process::id(),
+        stage_started.elapsed().as_micros()
+    );
     progress::emit(ProgressEvent::AddPhase { phase });
     fail_add_if_requested(phase, fail_after)
 }
