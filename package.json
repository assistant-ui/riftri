{
  "name": "riftri",
  "version": "0.6.8",
  "description": "Native copy-on-write Git worktrees for parallel development",
  "license": "MIT",
  "author": "Assistant UI contributors",
  "type": "commonjs",
  "bin": {
    "riftri": "package/bin/riftri.js"
  },
  "files": [
    "package/bin",
    "package/lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:native": "cargo build --locked -p riftri-cli",
    "check:packages": "node package/scripts/check-packages.mjs",
    "test": "pnpm run build:native && node --test --test-timeout=120000 package/test/*.test.js",
    "smoke:installed": "pnpm run build:native && node package/scripts/smoke-installed-package.mjs",
    "test:release": "node --test --test-timeout=120000 package/test/prepare-release.test.js",
    "pack:check": "pnpm run check:packages && node package/scripts/stage-root-package.mjs && npm pack ./dist/npm-root --dry-run"
  },
  "engines": {
    "node": ">=18.18"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "riftri-darwin-arm64": "file:package/platforms/riftri-darwin-arm64",
    "riftri-darwin-x64": "file:package/platforms/riftri-darwin-x64",
    "riftri-linux-arm64-gnu": "file:package/platforms/riftri-linux-arm64-gnu",
    "riftri-linux-arm64-musl": "file:package/platforms/riftri-linux-arm64-musl",
    "riftri-linux-x64-gnu": "file:package/platforms/riftri-linux-x64-gnu",
    "riftri-linux-x64-musl": "file:package/platforms/riftri-linux-x64-musl",
    "riftri-win32-arm64": "file:package/platforms/riftri-win32-arm64",
    "riftri-win32-x64": "file:package/platforms/riftri-win32-x64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/riftri.git"
  },
  "bugs": {
    "url": "https://github.com/assistant-ui/riftri/issues"
  },
  "homepage": "https://riftri.dev",
  "keywords": [
    "git",
    "worktree",
    "copy-on-write",
    "developer-tools",
    "coding-agents"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "package/lib/client.js",
  "types": "package/lib/client.d.ts",
  "exports": {
    ".": {
      "types": "./package/lib/client.d.ts",
      "require": "./package/lib/client.js",
      "default": "./package/lib/client.js"
    }
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8"
}
